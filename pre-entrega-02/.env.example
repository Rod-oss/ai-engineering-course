# Modelo compatible con OpenAI. Aquí: Gemini, mediante su API compatible con OpenAI.
# Para OpenAI real: usa tu clave de OpenAI y deja OPENAI_BASE_URL vacío.
OPENAI_API_KEY=tu-clave-aqui
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash-lite
OPENAI_TIMEOUT=30