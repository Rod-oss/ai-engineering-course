# LLM de los agentes: "google" (Gemini nativo) u "openai"
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=tu-clave-de-gemini

# Embeddings: deben ser los MISMOS con los que se indexó Pinecone (Pre-entrega 4)
OPENAI_API_KEY=tu-clave-de-gemini
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone
PINECONE_API_KEY=tu-clave-de-pinecone
INDEX_NAME=kestrel-hybrid-rag
PINECONE_NAMESPACE=kestrel-docs