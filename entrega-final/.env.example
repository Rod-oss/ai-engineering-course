# Copia este archivo como .env:  cp .env.example .env   (run.sh lo hace solo si falta)

# Claves. En GitHub Codespaces vienen de los secrets GEMINI_API_KEY y PINECONE_API_KEY: no las escribas aquí.
# Fuera de Codespaces, quita el # de estas dos líneas y pon tus claves. Nunca subas .env a GitHub.
# GEMINI_API_KEY=tu-clave-de-gemini
# PINECONE_API_KEY=tu-clave-de-pinecone

# LLM de los agentes
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_RPM=12

# Embeddings (los mismos con los que se indexó Pinecone)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Pinecone
PINECONE_INDEX=kestrel-hybrid-rag
PINECONE_NAMESPACE=kestrel-docs

# Recuperación híbrida
RAG_TOP_K=4
RAG_PESO_VECTORIAL=0.5

# Servicio (Docker Compose reemplaza REDIS_URL y PHOENIX_ENDPOINT por los nombres de sus servicios)
WORKER_CONCURRENCY=2
REDIS_URL=redis://localhost:6379
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=kestrel-intelligence
