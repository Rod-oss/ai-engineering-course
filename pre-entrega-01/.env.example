# Proveedor por defecto: "openai" o "anthropic"
LLM_PROVIDER=openai

# Cliente estilo OpenAI. Aquí: Gemini, mediante su API compatible con OpenAI.
# Para OpenAI real: usa tu clave de OpenAI y deja OPENAI_BASE_URL vacío.
OPENAI_API_KEY=tu-clave-aqui
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash-lite
OPENAI_TIMEOUT=30

# Cliente estilo Anthropic. Aquí: Ollama local, compatible con la API de Anthropic.
# Para Anthropic real: usa tu clave de Anthropic y deja ANTHROPIC_BASE_URL vacío.
ANTHROPIC_API_KEY=ollama
ANTHROPIC_BASE_URL=http://127.0.0.1:11434
ANTHROPIC_MODEL=qwen2.5:1.5b
ANTHROPIC_TIMEOUT=120